{
  "name": "greenrev-roadtrip",
  "version": "3.0.0",
  "private": true,
  "description": "GreenRev Roadtrip: drive Nigeria's highways city to city. A retention game for the GreenRev web and mobile apps.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:single": "vite build --mode single",
    "preview": "vite preview",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "build:lib": "vite build --mode lib",
    "typecheck": "tsc --noEmit",
    "api": "node server/node-server.ts"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5",
    "typescript": "^5.6.3",
    "@types/three": "^0.186.0",
    "@types/node": "^22.10.0"
  },
  "main": "./dist-lib/greenrev-roadtrip.js",
  "types": "./src/mount.ts",
  "exports": {
    ".": "./dist-lib/greenrev-roadtrip.js",
    "./style.css": "./dist-lib/greenrev-roadtrip.css",
    "./server": "./server/handlers.ts",
    "./server/store": "./server/store.ts"
  },
  "files": [
    "dist-lib",
    "server",
    "src",
    "public"
  ],
  "engines": {
    "node": ">=22.18"
  }
}
